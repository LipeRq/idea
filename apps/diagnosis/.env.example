# ---- AIレポート ----
# Claude APIキー。未設定の場合はAIを使わない標準レポートを返す
ANTHROPIC_API_KEY=

# ---- PDFレポート ----
# AIの文章に付ける署名の鍵。PDFに使う文章が改ざんされていないかを確かめる。本番では必ず設定する
# 例:openssl rand -hex 32
REPORT_SIGNING_SECRET=
# PDFのヘッダー・フッターに出す発行元の名前。未設定なら「AI導入診断」
REPORT_BRAND_NAME=

# ---- 画面(ビルド時に埋め込まれる。変えたらビルドし直す) ----
# 申し込みフォームの同意欄からリンクするプライバシーポリシーのURL。本番では必ず設定する
NEXT_PUBLIC_PRIVACY_POLICY_URL=
# 外部の問い合わせ窓口のURL。PDFの申し込み先と、フォームを送れなかったときの案内に使う
NEXT_PUBLIC_CONTACT_URL=

# ---- 無料相談の申し込みの送信先(両方設定すれば両方に送る) ----
# Salesforce Web-to-Lead。組織ID(00Dで始まる15桁または18桁)を設定すると有効になる
SALESFORCE_ORG_ID=
# リードソースに入れる値(任意)
SALESFORCE_LEAD_SOURCE=
# 診断の値をカスタム項目に入れる対応付け(任意・JSON)。キーは README を参照
# 例:{"industry":"00N5g00000AbCdE","annualSavedAmount":"00N5g00000AbCdG"}
SALESFORCE_FIELD_MAP=
# 送信先URL(任意)。未設定なら https://webto.salesforce.com/servlet/servlet.WebToLead
SALESFORCE_WEB_TO_LEAD_URL=
# 設定すると Salesforce から受信内容のメールが届く(設定の確認用・任意)
SALESFORCE_DEBUG_EMAIL=

# Webhook。Slack の Incoming Webhook のURLなら Slack 向けの本文で送る
LEAD_WEBHOOK_URL=
# slack または json(任意)。未設定なら URL から判断する
LEAD_WEBHOOK_FORMAT=
# 設定すると本文の HMAC-SHA256 を X-Lead-Signature ヘッダーに付ける(任意)
LEAD_WEBHOOK_SECRET=

# true にすると、本番でも申し込みを(個人情報を伏せて)サーバーログに出すだけにする(検証環境・E2E用)
# 開発時(next dev)は送信先が未設定なら自動でログに出す
LEAD_LOG_ONLY=

# ---- 回数制限(送信元ごと・1時間あたり)。未設定なら括弧内の値 ----
# 診断(5)
RATE_LIMIT_DIAGNOSE_PER_HOUR=
# PDFの作成(30)
RATE_LIMIT_REPORT_PER_HOUR=
# 申し込み(5)
RATE_LIMIT_LEAD_PER_HOUR=
