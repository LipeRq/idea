# 公開時の手順と、本番で必須・任意の区別は docs/deploy.md を参照

# ---- AIレポート ----
# Claude APIキー。未設定の場合はAIを使わない標準レポートを返す
ANTHROPIC_API_KEY=
# Claude を呼ぶ回数の上限(サイト全体・日本時間の1日)。超えたら標準レポートにする。0ならAIを使わない
# 未設定なら上限なし。本番では必ず設定する(例:50)
AI_DAILY_LIMIT=

# ---- PDFレポート ----
# AIの文章に付ける署名の鍵。PDFに使う文章が改ざんされていないかを確かめる。本番では必ず設定する
# 例:openssl rand -hex 32
REPORT_SIGNING_SECRET=
# 運営者名。PDFの発行元、ページのタイトル・フッター、OGP画像に出す(ビルド時にも使う)
# 未設定ならPDFは「AI導入診断」、ページには運営者名を出さない
REPORT_BRAND_NAME=

# ---- 画面(ビルド時に埋め込まれる。変えたらビルドし直す) ----
# 公開URL(例:https://shindan.example.co.jp)。OGP・canonical・robots.txt・sitemap.xml に使う
# 未設定なら Vercel の本番ドメイン、それもなければ http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# プライバシーポリシーのURL。フッター・申し込みフォームの同意欄・「いま困っていること」の注記からリンクする。本番では必ず設定する
NEXT_PUBLIC_PRIVACY_POLICY_URL=
# 利用規約のURL。フッターと申し込みフォームからリンクする。未設定ならリンクを出さない(公開時は設定を推奨)
NEXT_PUBLIC_TERMS_URL=
# 外部の問い合わせ窓口のURL。PDFの申し込み先と、フォームを送れなかったときの案内に使う
NEXT_PUBLIC_CONTACT_URL=
# 結果画面・PDFの「あわせて使えるツール」のリンク先(src/lib/diagnosis/related-tools.ts のルールで案内する)
# 未設定ならリンクを出さず「無料相談でご案内します」として申し込みフォームへ誘導する
# Excelマクロ・Accessの棚卸しツール(apps/inventory-web)の画面のURL
NEXT_PUBLIC_INVENTORY_TOOL_URL=
# 見積アシストのデモの紹介ページ(録画など)のURL。ツール本体(apps/quote-assist)は社外に公開しないので入れない
NEXT_PUBLIC_QUOTE_ASSIST_DEMO_URL=

# ---- 無料相談の申し込みの送信先(両方設定すれば両方に送る) ----
# Salesforce Web-to-Lead。組織ID(00Dで始まる15桁または18桁)を設定すると有効になる
SALESFORCE_ORG_ID=
# リードソースに入れる値(任意)
SALESFORCE_LEAD_SOURCE=
# 診断の値をカスタム項目に入れる対応付け(任意・JSON)。キーは README を参照
# 例:{"industry":"00N5g00000AbCdE","annualSavedAmount":"00N5g00000AbCdG"}
SALESFORCE_FIELD_MAP=
# 送信先URL(任意)。未設定なら https://webto.salesforce.com/servlet/servlet.WebToLead
SALESFORCE_WEB_TO_LEAD_URL=
# 設定すると Salesforce から受信内容(個人情報を含む)のメールが届く(設定の確認用・任意)
# 本番(NODE_ENV=production かつ VERCEL_ENV=production)では警告を出して使わない。確認が済んだら外す
SALESFORCE_DEBUG_EMAIL=

# Webhook。Slack の Incoming Webhook のURLなら Slack 向けの本文で送る
LEAD_WEBHOOK_URL=
# slack または json(任意)。未設定なら URL から判断する
LEAD_WEBHOOK_FORMAT=
# 設定すると本文の HMAC-SHA256 を X-Lead-Signature ヘッダーに付ける(任意)
LEAD_WEBHOOK_SECRET=

# true にすると、本番でも申し込みを(個人情報を伏せて)サーバーログに出すだけにする(検証環境・E2E用)
# 開発時(next dev)は送信先が未設定なら自動でログに出す
LEAD_LOG_ONLY=

# ---- 計測(ビルド時に埋め込まれる) ----
# ga4 / vercel / debug(ページの変数とコンソールに出すだけ。確認用)。未設定なら計測しない
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# GA4 の測定ID(G- で始まる)。NEXT_PUBLIC_ANALYTICS_PROVIDER=ga4 のときに必要
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- ボット対策(Cloudflare Turnstile)。両方設定したときだけ有効 ----
# サイトキー(ビルド時に埋め込まれる)。手元の確認には常に成功するテスト用のキー 1x00000000000000000000AA を使える
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# シークレット。テスト用は 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ---- 回数の共有ストア(Upstash Redis の REST API) ----
# 設定すると、回数制限とAIの1日の上限をインスタンスをまたいで数える。Vercel では必ず設定する
# 未設定ならサーバーのメモリで数える(Vercel の Marketplace 経由なら KV_REST_API_URL / KV_REST_API_TOKEN でもよい)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 共有ストアのキーに置く送信元(IPアドレス)の HMAC-SHA256 の鍵。本番では必ず設定する(例:openssl rand -hex 32)
# このための専用の値にする(REPORT_SIGNING_SECRET などを流用しない)。未設定なら鍵なしの SHA-256(本番では警告)
# 設定・変更すると共有ストアのキーが変わり、その時点までの回数は数え直しになる
DIAGNOSIS_RATE_LIMIT_HASH_SECRET=

# ---- 回数制限(送信元ごと・1時間あたり)。未設定なら括弧内の値 ----
# 診断(5)
RATE_LIMIT_DIAGNOSE_PER_HOUR=
# PDFの作成(30)
RATE_LIMIT_REPORT_PER_HOUR=
# 申し込み(5)
RATE_LIMIT_LEAD_PER_HOUR=
# 送信元の判断。Vercel 上は x-vercel-forwarded-for を使うので不要。Vercel 以外で、信頼できるリバースプロキシを
# 1段手前に置くときだけ true(x-forwarded-for の末尾を使う)。どちらでもなければ全員で1つの枠を共有する
DIAGNOSIS_TRUST_PROXY=
