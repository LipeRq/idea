# --- AI(Claude API) ---
# 未設定ならデモモード(合成データのサンプル図面に、AIと同じ形の固定の読み取り結果を返す)
ANTHROPIC_API_KEY=
# demo にすると、APIキーがあってもAIを使わない(デモや社外での説明用)
AI_PROVIDER=
# 概算費用の円換算(1ドルあたり。既定150)
USD_JPY=150

# --- 保存先 ---
# file(既定)または memory(再起動で消える。テスト用)
STORAGE_DRIVER=file
# 引き合い・図面PDF・モックCRMの保存ディレクトリ(既定 .data/)
QUOTE_ASSIST_DATA_DIR=
# 共用環境(SaaS)で会社ごとに保存先を分けるときのID(英数字・-・_)
TENANT_ID=
# 単価表・顧客・過去案件などの参照データのディレクトリ(既定 data/)
QUOTE_ASSIST_REFERENCE_DIR=

# --- Salesforce ---
# 次の3つがすべてそろったときだけ本番のREST APIを使う(それ以外はモック)。mock にすると常にモック
CRM_PROVIDER=
# My Domain のURL(例 https://example.my.salesforce.com)。https のみ
SF_INSTANCE_URL=
# 接続アプリケーション(クライアントクレデンシャルフローを有効化)の値
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# REST APIのバージョン(既定 v62.0)
SF_API_VERSION=
# 作成する商談のフェーズ(組織の選択リストにある値。既定 Proposal/Price Quote)
SF_OPPORTUNITY_STAGE=
