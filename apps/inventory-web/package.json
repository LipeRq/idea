{
  "name": "inventory-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev -p 3400",
    "dev:worker": "node scripts/build-worker.mjs --watch",
    "prebuild": "node scripts/prepare.mjs",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -p 3401",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
