# マクロ棚卸し(apps/inventory-web)の環境変数の例。
# 手元では .env.local にコピーして使う(.env* は git に入れない。このファイルだけ例外)。
# 何も設定しなくても、標準の仕様書(AI なし・ブラウザ内で完結)はすべて動く。

# ---- 画面のリンク(ビルド時に埋め込まれる。変えたらビルドし直す) ----
# 移行・改修の相談ページ(未設定なら相談リンクを出さない。解析結果は URL に一切付けない)
NEXT_PUBLIC_CONTACT_URL=
# プライバシーポリシー(同意画面と「仕組みとデータの扱い」に出す)
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# ---- AI 版(詳しい仕様書)。実行時に読むので、変えたら再起動だけでよい ----
# off(既定): AI 版を出さない / mock: Claude を呼ばずにデモ用の固定文章を返す / claude: Claude で作る
INVENTORY_AI_MODE=off
# claude のときに必須(エンジンの new Anthropic() が読む)。ANTHROPIC_AUTH_TOKEN でもよい
ANTHROPIC_API_KEY=
# claude のときは既定で必須(コンサルタント専用にする)。利用者は同意画面で入力する
INVENTORY_AI_ACCESS_CODE=
# true にすると、アクセスコードなしで誰でも AI 版を使える(費用に注意。既定は false)
INVENTORY_AI_ALLOW_ANONYMOUS=false

# ---- 費用の歯止め(読み取れない値は「AI を使わない」側に倒す。0 で停止) ----
# 送信元ごとの1時間あたりの回数
INVENTORY_AI_PER_HOUR=3
# サイト全体の1日の回数(日本時間で区切る。失敗した依頼も数える)
INVENTORY_AI_DAILY_LIMIT=20
# サイト全体の1日の推定入力トークン
INVENTORY_AI_DAILY_INPUT_TOKENS=2000000
# 1回の依頼の推定入力トークンの上限
INVENTORY_AI_MAX_INPUT_TOKENS=200000
# 1回の依頼でのモジュール要約の回数の上限
INVENTORY_AI_MAX_BATCHES=8
# 送信内容(本文)のバイト数の上限。Vercel の関数の本文の上限(4.5MB)より小さくする
INVENTORY_AI_MAX_BODY_BYTES=4000000
# mock のときの1回の応答の待ち時間(ミリ秒。進捗の表示を確かめるため)
INVENTORY_AI_MOCK_DELAY_MS=300

# ---- 回数を共有ストアで数える(サーバーレスでは必須。Vercel 上では未設定だと claude モードを使わない) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel の Marketplace 経由なら KV_REST_API_URL / KV_REST_API_TOKEN でもよい)
# Vercel 以外のサーバーレスで共有ストアを必須にする
INVENTORY_AI_REQUIRE_SHARED_STORE=false

# ---- 開発・テスト用 ----
# 「サンプルで試す」の取り込み元(既定は ../inventory/samples)
INVENTORY_SAMPLES_DIR=
