# 値は GitHub の Secrets(毎朝の情報まとめ)と Vercel の環境変数(打ち合わせメモ)に入れる。このファイルには名前だけを書く

# Claude API のキー。未設定なら毎朝の情報まとめは見出しだけになり、打ち合わせメモは整理できない
ANTHROPIC_API_KEY=

# LINE Developers のチャネル(Messaging API)の「チャネルアクセストークン(長期)」
LINE_CHANNEL_ACCESS_TOKEN=

# 同じチャネルの「あなたのユーザーID」(U で始まる)。送り先であり、受け付ける唯一の相手
LINE_USER_ID=

# 同じチャネルの「チャネルシークレット」。受信用のサーバー(Vercel)だけで使う
LINE_CHANNEL_SECRET=
