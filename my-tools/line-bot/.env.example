# 値は GitHub の Secrets(毎朝の情報まとめ)と Cloudflare の Secrets(打ち合わせメモ)に入れる。このファイルには名前だけを書く
# (手元で `npm run dev` を試すときは、同じ名前で .dev.vars に書く。.dev.vars はコミットしない)

# DeepSeek API のキー。未設定なら毎朝の情報まとめは見出しだけになり、打ち合わせメモは整理できない
DEEPSEEK_API_KEY=

# LINE Developers のチャネル(Messaging API)の「チャネルアクセストークン(長期)」
LINE_CHANNEL_ACCESS_TOKEN=

# 同じチャネルの「あなたのユーザーID」(U で始まる)。送り先であり、受け付ける唯一の相手
LINE_USER_ID=

# 同じチャネルの「チャネルシークレット」。受信用のサーバー(Cloudflare)だけで使う
LINE_CHANNEL_SECRET=
